# ==============================================================================
# ShiftFX Production Security Environment Template
# NEVER commit the actual .env file containing live secrets to source control.
# Generate high-entropy secrets using: openssl rand -hex 32
# ==============================================================================

# Django Master Secret Key (Minimum 64 random characters in production)
# Example generation: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_HIGH_ENTROPY_64_CHAR_KEY_GENERATED_BY_OPENSSL

# Application Settings
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production

# Host Hardening (Comma-separated exact domains, NO wildcards)
ALLOWED_HOSTS=shiftfx.io,terminal.shiftfx.io,admin.shiftfx.io,127.0.0.1,localhost

# Strict CORS Allowed Origins (Comma-separated exact HTTPS origins)
CORS_ALLOWED_ORIGINS=https://shiftfx.io,https://terminal.shiftfx.io,https://admin.shiftfx.io

# CSRF Trusted Origins (Comma-separated exact HTTPS origins)
CSRF_TRUSTED_ORIGINS=https://shiftfx.io,https://terminal.shiftfx.io,https://admin.shiftfx.io

# Production PostgreSQL Database Credentials
DB_NAME=shiftfx_production
DB_USER=shiftfx_db_user
DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=require

# SSL and HSTS Transport Enforcement
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Gunicorn Production Concurrency
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=60
